# PostgreSQL container
POSTGRES_DB=applyflow
POSTGRES_USER=applyflow
POSTGRES_PASSWORD=applyflow

# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=applyflow
DB_USERNAME=applyflow
DB_PASSWORD=applyflow
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173
SESSION_TIMEOUT=12h
REMEMBER_ME_DURATION=30d
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
# Create a Google OAuth Web application and keep its credentials only in your local .env.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# Keep mode=none unless the backend is reachable only through the listed proxy CIDRs.
TRUSTED_PROXY_HEADER_MODE=none
TRUSTED_PROXY_CIDRS=
# Local Mailpit SMTP. Production overrides these values through its secret store.
MAIL_DELIVERY_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@applyflow.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_OUTBOX_RETRY_INTERVAL=PT2S
OUTBOX_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MAIL_OUTBOX_CLAIM_LEASE=PT5M
AUTH_RATE_LIMIT_WINDOW=PT15M
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RECOVERY_RATE_LIMIT=5
AUTH_RESET_RATE_LIMIT=8
JOB_OFFER_EXTRACTION_RATE_LIMIT=20
JOB_OFFER_CONNECT_TIMEOUT=2s
JOB_OFFER_READ_TIMEOUT=3s
JOB_OFFER_TOTAL_TIMEOUT=5s
JOB_OFFER_MAX_HTML_BYTES=1048576
JOB_OFFER_MAX_REDIRECTS=3
JOB_OFFER_MAX_CONCURRENT=8

# Frontend (public backend location only; never put secrets in VITE_* values)
VITE_BACKEND_BASE_URL=http://localhost:8080
